# Wikitizer environment — copy to .env and fill in. (.env is gitignored; this template is not.)
# load_dotenv() in main.py pulls these into the environment before the pipeline runs.

# ============================================================================
# REQUIRED — the default setup: everything runs on Anthropic.
# Noise filter -> Haiku, every other agent -> Sonnet. Set this one key and you're
# done; you do NOT need anything in the OPTIONAL section below.
# ============================================================================
ANTHROPIC_API_KEY=

# --- Dev response cache (equivalent to main.py --cache) ---
# Reuse cached LLM responses for identical extractor/noise-filter calls on a re-run of the
# same logs (a gitignored .llm_cache/ dir; never expires). Off unless set. Also the
# resume-after-a-freeze lever: a killed run's completed calls replay instantly on the retry.
WIKITIZER_LLM_CACHE=          # 1 / true / yes / on to enable

# --- Per-request timeout (seconds) ---
# Caps how long a single LLM request may stall before failing + auto-retrying (max_retries=3),
# so one hung request can't freeze the whole run. Default 300; the SDK's own default is 600.
# Raise it only if a legitimate slow call ever gets killed (a full 8192-token reply can take ~230s).
WIKITIZER_LLM_TIMEOUT=        # e.g. 300

# ============================================================================
# OPTIONAL / advanced — route some agents to a cheaper OpenAI-compatible model
# (OpenRouter, Fireworks; e.g. GLM-5.2) instead of Anthropic. Skip this ENTIRE
# section to run on Anthropic (the recommended default). Leaving these blank/unset
# changes nothing.
# ============================================================================

# The gateway for any agent routed below. The key var is LLM_OPENAI_API_KEY, NOT
# OPENROUTER_API_KEY. Leave blank when running everything on Anthropic.
LLM_OPENAI_BASE_URL=          # e.g. https://openrouter.ai/api/v1   (Fireworks: https://api.fireworks.ai/inference/v1)
LLM_OPENAI_API_KEY=

# Per-agent model. UNSET -> the Anthropic default shown. Prefix a value with "openrouter:"
# or "openai:" to route THAT role to the gateway above; with no prefix it's an Anthropic
# model string. Confirm the exact slug on your provider (OpenRouter's model list, etc.).
WIKITIZER_NOISE_MODEL=        # default: claude-haiku-4-5-20251001   | override e.g. openrouter:z-ai/glm-5.2
WIKITIZER_PROSE_MODEL=        # default: claude-sonnet-4-6           | override e.g. openrouter:z-ai/glm-5.2
WIKITIZER_EXTRACT_MODEL=      # default: claude-sonnet-4-6           | override e.g. openrouter:z-ai/glm-5.2
WIKITIZER_RECONCILE_MODEL=    # default: claude-sonnet-4-6           | override e.g. openrouter:z-ai/glm-5.2

# Reasoning control for OpenAI-compatible (GLM etc.) roles ONLY — never affects Anthropic.
# GLM-5.2 reasons for thousands of tokens by default -> slow, truncation, chain-of-thought
# leaking into the response. Turn it off with:
#   off                 -> disable thinking (sends both the OpenRouter param + the provider toggle)
#   low | medium | high -> cap reasoning effort instead of disabling it
#   {..json..}          -> raw extra_body, verbatim (escape hatch, e.g. if a provider 400s:
#                          {"chat_template_kwargs":{"enable_thinking":false}} )
# Unset -> provider default.
WIKITIZER_OPENAI_REASONING=   # e.g. off
